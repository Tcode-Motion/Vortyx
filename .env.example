# ==============================================================================
# VORTYX UNIVERSAL MEDIA DOWNLOADER & HUB - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment ('production' or 'development')
NODE_ENV=production

# HTTP Port (default: 3000)
PORT=3000

# Custom Storage Directory for downloaded media files, chunk streams, and persistent jobs.
# Defaults to .vortyx_storage in project root if unset.
# MEDIA_STORAGE_DIR=/var/data/vortyx_storage

# Storage Retention TTL in milliseconds (default: 1800000 = 30 minutes)
STORAGE_TTL_MS=1800000

# Executable Paths (Optional: automatically resolved from system PATH if not specified)
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe

# Rate Limiting (default: 30 requests per minute per IP)
RATE_LIMIT_MAX_PER_MIN=30

# SSRF Protection (Strict IP Whitelisting & DNS-Rebind Guard)
SSRF_GUARD_ENABLED=true
